#!/usr/bin/env bash
# This script configures Nginx by linking the default site and restarting the server to ensure it serves a page on port 80

# Remove any existing symlink or file for default site
rm -f /etc/nginx/sites-enabled/default

# Create a new symbolic link to enable the default site
ln -s /etc/nginx/sites-available/default /etc/nginx/sites-enabled/default

# Test Nginx configuration before applying changes
nginx -t

# Restart Nginx service to apply the configuration
service nginx restart

# Optional: Wait briefly to ensure the service restarts
sleep 1

# Check if the server is responding with HTTP 200 on port 80
curl -s -o /dev/null -w "%{http_code}" http://localhost | grep 200
